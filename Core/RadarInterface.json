{
  "interface_version": "1.0.0",
  "platforms": ["vessel", "aircraft"],
  "shared_types": {
    "ping": {
      "platform_id": "string",
      "platform_type": "vessel|aircraft",
      "vessel_class": "freight_carrier|ferry|speedboat",
      "aircraft_class": "airliner|private|cargo|rotorcraft",
      "timestamp_iso": "ISO8601",
      "position": {"x": 0.0, "y": 0.0, "z": 0.0},
      "velocity": {"x": 0.0, "y": 0.0, "z": 0.0},
      "heading_deg": 0.0,
      "speed_knots": 0.0,
      "range_m": 0.0,
      "intent": "transit|approach|hold|landing|takeoff|idle"
    },
    "avoidance_policy": {
      "time_horizon_s": 120,
      "cpa_limit_m": 200,
      "reaction": {
        "freight_carrier": "course_offset+slow",
        "ferry": "course_offset+notify",
        "speedboat": "course_offset+fast",
        "airliner": "course_offset+slow+notify_center",
        "private": "course_offset+fast",
        "cargo": "course_offset+slow",
        "rotorcraft": "hover+avoid"
      },
      "classes": {
        "freight_carrier": {"stop_distance_m": 800, "turn_radius_m": 600},
        "ferry": {"stop_distance_m": 350, "turn_radius_m": 220},
        "speedboat": {"stop_distance_m": 80, "turn_radius_m": 35},
        "airliner": {"stop_distance_m": 2000, "turn_radius_m": 1500},
        "private": {"stop_distance_m": 300, "turn_radius_m": 200},
        "cargo": {"stop_distance_m": 1500, "turn_radius_m": 1200},
        "rotorcraft": {"stop_distance_m": 50, "turn_radius_m": 0}
      }
    }
  },
  "echolocation": {
    "inspired_by": "cetacean biosonar",
    "modes": ["active_ping", "passive_listen", "doppler_shift"],
    "max_range_m": 50000,
    "update_hz": 4
  }
}
